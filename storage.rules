rules_version = '2';
// Bilder av skannede originalark. Kontoret (admin) og kontroll kan se, laste opp og slette.
service firebase.storage {
  match /b/{bucket}/o {
    function erKontor() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/roller/$(request.auth.uid)).data.rolle in ["admin", "kontroll"];
    }
    // E-postvedlegg lagt hit av skyfunksjonen «innboks»
    match /innboks/{fil} {
      allow read, delete: if erKontor();
    }
    match /skann/{id} {
      allow read, delete: if erKontor();
      allow create, update: if erKontor() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
